module

public import SpectralGeometry.AmmannBeenkerNearCrossingEigenvectors

public section

/-!
# Duration-independent leakage bound from a conserved pulse residual

This module works in the full real infinite-graph Hilbert space.
It uses the certified reduced gap g = 1/128 and the exact
rank-one edge norm ‖W‖ = 2.

A constant-strength edge pulse can be controlled without first
constructing the perturbed rank-two spectral projection. If a final
natural-domain state has the same norm and the same *perturbed*
shifted-Hamiltonian residual norm as an initial crossing eigenstate,
then its total leakage from the original compact plane is bounded
uniformly by 512|ε| times the initial norm.

The two conservation laws are explicit hypotheses. They are expected
from complex unitary Schrödinger evolution generated by the fixed
self-adjoint perturbed Hamiltonian, but that propagator is not yet
constructed in this repository. Neither state preparation nor any
nontrivial A/B rotation is asserted here.
-/

namespace SpectralGeometry.AmmannBeenker

noncomputable section

/-- The shifted residual with respect to the *perturbed*
full natural-domain operator, measured at the original crossing
energy. -/
@[expose] def crossingEdgePulseResidual (ε : ℝ)
    (x : infiniteOnsiteDomain potential) : TileHilbert Vertex :=
  onsitePlusBounded potential
      (ringInteraction crossingParameter + ε • crossingEdge) x -
    crossingEnergy • (x : TileHilbert Vertex)

/-- The perturbed residual equals the original residual plus
the bounded edge force. -/
theorem crossingEdgePulseResidual_eq (ε : ℝ)
    (x : infiniteOnsiteDomain potential) :
    crossingEdgePulseResidual ε x =
      (onsitePlusBounded potential (ringInteraction crossingParameter) x -
          crossingEnergy • (x : TileHilbert Vertex)) +
        ε • crossingEdge (x : TileHilbert Vertex) := by
  unfold crossingEdgePulseResidual
  rw [crossingEdge_perturbation_identity]
  abel

/-- For an initial vector in the exact crossing eigenspace,
the entire perturbed residual is just the edge force. -/
theorem crossingEdgePulseResidual_of_crossing_eigenvector
    (ε : ℝ) (x : infiniteOnsiteDomain potential)
    (hx :
      onsitePlusBounded potential (ringInteraction crossingParameter) x =
        crossingEnergy • (x : TileHilbert Vertex)) :
    crossingEdgePulseResidual ε x =
      ε • crossingEdge (x : TileHilbert Vertex) := by
  rw [crossingEdgePulseResidual_eq, hx, sub_self, zero_add]

/-- The original crossing residual is bounded by the perturbed
residual plus the norm of the applied edge term. -/
theorem crossingOriginalResidual_le_pulseResidual
    (ε : ℝ) (y : infiniteOnsiteDomain potential) :
    ‖onsitePlusBounded potential (ringInteraction crossingParameter) y -
        crossingEnergy • (y : TileHilbert Vertex)‖ ≤
      ‖crossingEdgePulseResidual ε y‖ +
        |ε| * ‖crossingEdge (y : TileHilbert Vertex)‖ := by
  have hident :
      onsitePlusBounded potential (ringInteraction crossingParameter) y -
          crossingEnergy • (y : TileHilbert Vertex) =
        crossingEdgePulseResidual ε y -
          ε • crossingEdge (y : TileHilbert Vertex) := by
    rw [crossingEdgePulseResidual_eq]
    abel
  rw [hident]
  calc
    ‖crossingEdgePulseResidual ε y -
          ε • crossingEdge (y : TileHilbert Vertex)‖ ≤
        ‖crossingEdgePulseResidual ε y‖ +
          ‖ε • crossingEdge (y : TileHilbert Vertex)‖ :=
      norm_sub_le _ _
    _ = ‖crossingEdgePulseResidual ε y‖ +
          |ε| * ‖crossingEdge (y : TileHilbert Vertex)‖ := by
      simp only [norm_smul, Real.norm_eq_abs]

/-- Uniform leakage bound for a constant-strength edge pulse.

The exact initial crossing eigenstate x and final state y are in
the same natural domain; only norm conservation and conservation
of the *perturbed* shifted-residual norm are needed. Both are
expressed as hypotheses rather than assuming a yet-unconstructed
quantum propagator. The bound does not involve elapsed time. -/
theorem crossingConservedPulseResidual_leakage_bound
    (ε : ℝ) (x y : infiniteOnsiteDomain potential)
    (hx :
      onsitePlusBounded potential (ringInteraction crossingParameter) x =
        crossingEnergy • (x : TileHilbert Vertex))
    (hnorm :
      ‖(y : TileHilbert Vertex)‖ = ‖(x : TileHilbert Vertex)‖)
    (hres :
      ‖crossingEdgePulseResidual ε y‖ =
        ‖crossingEdgePulseResidual ε x‖) :
    ‖crossingLeakage (y : TileHilbert Vertex)‖ ≤
      512 * |ε| * ‖(x : TileHilbert Vertex)‖ := by
  have hinitial :
      ‖crossingEdgePulseResidual ε x‖ ≤
        2 * |ε| * ‖(x : TileHilbert Vertex)‖ := by
    rw [crossingEdgePulseResidual_of_crossing_eigenvector ε x hx,
      norm_smul, Real.norm_eq_abs]
    calc
      |ε| * ‖crossingEdge (x : TileHilbert Vertex)‖ ≤
          |ε| * (2 * ‖(x : TileHilbert Vertex)‖) :=
        mul_le_mul_of_nonneg_left
          (crossingEdge_apply_norm_le_two (x : TileHilbert Vertex))
          (abs_nonneg ε)
      _ = 2 * |ε| * ‖(x : TileHilbert Vertex)‖ := by ring
  have hfinal :
      |ε| * ‖crossingEdge (y : TileHilbert Vertex)‖ ≤
        2 * |ε| * ‖(x : TileHilbert Vertex)‖ := by
    calc
      |ε| * ‖crossingEdge (y : TileHilbert Vertex)‖ ≤
          |ε| * (2 * ‖(y : TileHilbert Vertex)‖) :=
        mul_le_mul_of_nonneg_left
          (crossingEdge_apply_norm_le_two (y : TileHilbert Vertex))
          (abs_nonneg ε)
      _ = 2 * |ε| * ‖(x : TileHilbert Vertex)‖ := by
        rw [hnorm]
        ring
  have hgap := crossingReducedGapResidualEstimate_full y
  have htotal :
      crossingGapCandidate *
          ‖crossingLeakage (y : TileHilbert Vertex)‖ ≤
        4 * |ε| * ‖(x : TileHilbert Vertex)‖ := by
    calc
      crossingGapCandidate *
          ‖crossingLeakage (y : TileHilbert Vertex)‖ ≤
        ‖onsitePlusBounded potential (ringInteraction crossingParameter) y -
          crossingEnergy • (y : TileHilbert Vertex)‖ := hgap
      _ ≤ ‖crossingEdgePulseResidual ε y‖ +
          |ε| * ‖crossingEdge (y : TileHilbert Vertex)‖ :=
        crossingOriginalResidual_le_pulseResidual ε y
      _ ≤ (2 * |ε| * ‖(x : TileHilbert Vertex)‖) +
          (2 * |ε| * ‖(x : TileHilbert Vertex)‖) := by
        apply add_le_add
        · rw [hres]
          exact hinitial
        · exact hfinal
      _ = 4 * |ε| * ‖(x : TileHilbert Vertex)‖ := by ring
  change (1 / 128 : ℝ) *
      ‖crossingLeakage (y : TileHilbert Vertex)‖ ≤
    4 * |ε| * ‖(x : TileHilbert Vertex)‖ at htotal
  nlinarith

/-- For a normalized initial crossing state, the squared off-qubit
norm after a conserved-residual pulse is at most
(512|ε|)^2. Interpretation as measurement probability requires
the future complex quantum propagator. -/
theorem crossingConservedPulseResidual_leakage_sq_bound
    (ε : ℝ) (x y : infiniteOnsiteDomain potential)
    (hx :
      onsitePlusBounded potential (ringInteraction crossingParameter) x =
        crossingEnergy • (x : TileHilbert Vertex))
    (hunit : ‖(x : TileHilbert Vertex)‖ = 1)
    (hnorm :
      ‖(y : TileHilbert Vertex)‖ = ‖(x : TileHilbert Vertex)‖)
    (hres :
      ‖crossingEdgePulseResidual ε y‖ =
        ‖crossingEdgePulseResidual ε x‖) :
    ‖crossingLeakage (y : TileHilbert Vertex)‖ ^ 2 ≤
      (512 * |ε|) ^ 2 := by
  have h := crossingConservedPulseResidual_leakage_bound
    ε x y hx hnorm hres
  rw [hunit, mul_one] at h
  exact (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (by norm_num) (abs_nonneg ε))).mpr h

end
end SpectralGeometry.AmmannBeenker
